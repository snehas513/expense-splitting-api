@baseUrl = http://localhost:3000
@groupId = 1
@token = eyJhbGciOiJIUzI1NiJ9.eyJ1c2VyX2lkIjozLCJleHAiOjE3OTQ4MTY5ODl9.dC-eWBgyvJgZmHtRdvcgE_w8ZO1Yyd4LCXy8xu61nKI
@next_cursor = eyJleHBlbnNlX2RhdGUiOiIyMDI2LTExLTExIiwiaWQiOjIzfQ==

### Create expense
POST {{baseUrl}}/api/v1/groups/{{groupId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "payer_id": 2,
  "participant_ids": [2, 3],
  "amount": "1500.00",
  "description": "Dinner",
  "expense_date": "2026-11-11",
  "note": "Team dinner"
}

### Get group expenses
GET http://localhost:3000/api/v1/groups/1/expenses?limit=1
Authorization: Bearer {{token}}

### Get next page
GET http://localhost:3000/api/v1/groups/1/expenses?limit=1&cursor={{next_cursor}}
Authorization: Bearer {{token}}

### Get group balances
GET http://localhost:3000/api/v1/groups/1/balances
Authorization: Bearer {{token}}

### Create settlement
POST {{baseUrl}}/api/v1/groups/{{groupId}}/settlements
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "sender_id": 3,
  "receiver_id": 2,
  "settlement_amount": "200.00",
  "settlement_date": "2026-11-15",
  "note": "November settlement"
}