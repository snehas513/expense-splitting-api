@baseUrl = http://localhost:3000
@groupId = 1
@token = eyJhbGciOiJIUzI1NiJ9.eyJ1c2VyX2lkIjozLCJleHAiOjE3OTQ5ODgyODZ9.xZtWQX8F9s6wdrkmJSxw58vg0l2OpaUq52VU2pSU67M
@actedByToken = eyJhbGciOiJIUzI1NiJ9.eyJ1c2VyX2lkIjoyLCJleHAiOjE3OTQ4NDI0MDl9.dfTFqwBPtiyya_AiIIc0BMFxtacLMpIe4VPHHZUWhJM
@next_cursor = eyJleHBlbnNlX2RhdGUiOiIyMDI2LTExLTExIiwiaWQiOjIzfQ==
@settlementId = 6

### Create expense
POST {{baseUrl}}/api/v1/groups/{{groupId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "payer_id": 2,
  "participant_ids": [2, 3],
  "amount": "1500.00",
  "description": "Dinner",
  "expense_date": "2026-11-11",
  "note": "Team dinner"
}

### Get group expenses
GET http://localhost:3000/api/v1/groups/1/expenses?limit=1
Authorization: Bearer {{token}}

### Get next page
GET http://localhost:3000/api/v1/groups/1/expenses?limit=1&cursor={{next_cursor}}
Authorization: Bearer {{token}}

### Get group balances
GET http://localhost:3000/api/v1/groups/1/balances
Authorization: Bearer {{token}}

### Create settlement
POST {{baseUrl}}/api/v1/groups/{{groupId}}/settlements
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "sender_id": 3,
  "receiver_id": 2,
  "settlement_amount": "500.00",
  "settlement_date": "2026-11-15",
  "allocations": [
    {
      "expense_id": 10,
      "allocation_amount": "300.00"
    },
    {
      "expense_id": 12,
      "allocation_amount": "200.00"
    }
  ],
  "note": "November settlement"
}


### Confirm settlement
POST {{baseUrl}}/api/v1/groups/{{groupId}}/settlements/{{settlementId}}/confirm
Authorization: Bearer {{actedByToken}}
Content-Type: application/json

### Reject settlement
POST {{baseUrl}}/api/v1/groups/{{groupId}}/settlements/{{settlementId}}/reject
Authorization: Bearer {{actedByToken}}
Content-Type: application/json

### Cancel settlement
POST {{baseUrl}}/api/v1/groups/{{groupId}}/settlements/{{settlementId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

### Get group settlements
GET http://localhost:3000/api/v1/groups/1/settlements?status=cancelled&limit=100
Authorization: Bearer {{token}}

### Get next page
GET http://localhost:3000/api/v1/groups/1/settlements?limit=1&cursor={{next_cursor}}
Authorization: Bearer {{token}}

### Create group
POST {{baseUrl}}/api/v1/groups
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "DevOps Group",
  "description": null
}

### Get user's active groups
GET {{baseUrl}}/api/v1/groups
Authorization: Bearer {{token}}
Content-Type: application/json

### Get user group details
GET {{baseUrl}}/api/v1/groups/-1
Authorization: Bearer {{token}}

### Update user group details
PATCH  {{baseUrl}}/api/v1/groups/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "G1"
}

### Archive user group
POST  {{baseUrl}}/api/v1/groups/2/archive
Authorization: Bearer {{token}}
Content-Type: application/json

